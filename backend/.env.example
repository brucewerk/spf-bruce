# Copie este arquivo para .env e preencha os valores.

# Obrigatórias
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/spf-bruce
JWT_SECRET=troque-por-um-valor-longo-e-aleatorio

# Opcionais
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Origens extras liberadas no CORS, além das já hardcoded em src/config/cors.js
# (útil para novas URLs de preview do Vercel sem precisar alterar código).
# Separadas por vírgula.
# EXTRA_ALLOWED_ORIGINS=https://minha-preview-url.vercel.app

# Rastreamento de erros em produção (Sentry). Sem isso, o app funciona
# normalmente — só não envia erros pra lugar nenhum.
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# Rate limiting persistente (Redis via Upstash). Sem isso, o rate limit
# funciona só em memória local — o suficiente localmente, mas não é
# confiável no ambiente serverless do Vercel (cada invocação pode cair
# numa instância diferente). Crie um banco gratuito em upstash.com.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx
